# BEEPBIP environment template.
#
# Copy this file to .env.dev (for local), .env.staging, or .env.prod, and
# fill in real values. Never commit the populated copies — .gitignore already
# excludes them. This .env.example file IS committed and serves as the
# canonical list of keys the app expects.
#
# Selection at runtime:
#   flutter run --dart-define=FLAVOR=dev      # loads .env.dev (default)
#   flutter run --dart-define=FLAVOR=staging  # loads .env.staging
#   flutter run --dart-define=FLAVOR=prod     # loads .env.prod
#
# Rules:
#   - No secret that could sign server requests (service_role, Stripe secret,
#     RevenueCat secret) belongs here. Those live in the backend only.
#   - Everything here MUST be safe to ship inside the compiled app binary.

# --- Supabase --------------------------------------------------------------
# URL of the Supabase project API (REST/GraphQL/Auth).
SUPABASE_URL=

# "Publishable" key (formerly "anon key") — safe to embed in the client.
SUPABASE_PUBLISHABLE_KEY=

# --- Maps ------------------------------------------------------------------
# MapTiler / Protomaps style URL or API key. Optional in local dev.
MAPTILER_API_KEY=

# --- Social login (V1) -----------------------------------------------------
# Apple Sign In uses a service ID configured in the Apple Developer portal,
# not a secret shipped in the binary. Left blank during local dev.
APPLE_SERVICE_ID=

# Google OAuth iOS/Android client IDs, configured in the Google Cloud console
# and mirrored in Supabase Auth Providers.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Facebook App ID (public, not the app secret).
FACEBOOK_APP_ID=

# --- Payments (client-visible only) ----------------------------------------
# Publishable Stripe key (pk_test_* / pk_live_*). The secret key lives server
# side only and is NEVER referenced here.
STRIPE_PUBLISHABLE_KEY=

# --- Observability ---------------------------------------------------------
# PostHog client key (if used). Blank disables analytics.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Sentry/Crashlytics DSN (if used).
CRASH_REPORTING_DSN=

# --- App behavior ----------------------------------------------------------
# Default neighborhood slug to scope discovery when geolocation is unknown.
DEFAULT_NEIGHBORHOOD_SLUG=soho-nyc

# Turn extra logs on/off. true in dev, false in prod.
DEBUG_LOGS=true
