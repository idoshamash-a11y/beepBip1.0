# Edge Function secrets for the booking + Stripe Connect flows.
#
# Local dev:
#   1. Copy this file to `supabase/functions/.env` (gitignored) — already
#      added to .gitignore at repo root.
#   2. Drop in real values once Stripe keys are available, then run:
#        supabase functions serve --env-file supabase/functions/.env
#      The Flutter app at .env.dev will hit the local Edge Functions at
#      http://127.0.0.1:54321/functions/v1/<name>.
#
# Production:
#   Set these via `supabase secrets set --env-file supabase/functions/.env`
#   against the linked project.
#
# DEMO MODE:
#   While `bookings.demo_mode = TRUE` in `feature_flags`, the Flutter client
#   short-circuits with a mock checkout sheet and never hits these functions,
#   so leaving the placeholders below in place is fine for demos / staging.

# Stripe restricted/test secret. Format: sk_test_… (test) or sk_live_… (prod).
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret (Stripe Dashboard → Developers → Webhooks → endpoint).
# Format: whsec_…
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Public site origin used by Stripe Checkout success/cancel redirects.
# For local dev with Flutter's deeplink scheme:
PUBLIC_SITE_URL=beepbip://app

# Platform fee in basis points (800 = 8%). Override per-environment if needed.
PLATFORM_FEE_BPS=800

# ---------------------------------------------------------------------------
# dev-seed-mockups
# ---------------------------------------------------------------------------
# Set to "true" to allow the mockup seeder to run against a NON-LOCAL
# SUPABASE_URL. Leave unset (or "false") in any normal environment — the
# function self-refuses unless this is explicit, so a stray button-press
# can never wipe a real database.
ALLOW_DEV_SEED=false
